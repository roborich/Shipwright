// SOH [WASM] Generated by CMake from soh/wasm/build-info.js.in and compiled into soh.js with
// --pre-js, so it runs before preRun. Tells the page that loads soh.js how this module was
// built; host-page.js reads it.
Module['sohBuild'] = {
  // true: oot.o2r, config and saves come from Module.shipFiles (SOH_WASM_HOST_FILES=ON).
  hostFiles: @SOH_WASM_BUILD_INFO_HOST_FILES@,
  // Paths packaged in soh.data. A page must not write these itself.
  bakedFiles: [@SOH_WASM_BUILD_INFO_BAKED_FILES@],
};
